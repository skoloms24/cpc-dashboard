# ---- Sign-in: Google Workspace SSO (same Google OAuth client as the SMS Portal works) ----
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_URL=                         # this app's public URL, e.g. https://cpc.allstartalent.us
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=             # REQUIRED. Your Google Workspace domain. If empty, nobody can sign in.
ADMIN_EMAILS=                     # comma-separated; these people see the Admin page

# ---- Database (Vercel -> Storage -> Neon Postgres sets this for you) ----
DATABASE_URL=

# ---- Weekly job ----
CRON_SECRET=                      # any long random string; Vercel sends it to the cron route

# ---- Meta Marketing API (optional; turns on when both are set) ----
META_ACCESS_TOKEN=                # System User token with ads_read
META_AD_ACCOUNT_IDS=              # comma-separated, numbers only
META_API_VERSION=v23.0

# ---- Google Ads API (optional; turns on when all are set) ----
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=     # manager account ID, digits only
GOOGLE_ADS_API_VERSION=v21

# ---- Outlook report emails (optional; needs a Microsoft 365 admin to grant Mail.Read) ----
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_FOLDER=CPC Reports
