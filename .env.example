# ---- Sign-in (Microsoft Entra ID app registration) ----
AUTH_SECRET=                      # run: npx auth secret   (any long random string)
AUTH_MICROSOFT_ENTRA_ID_ID=       # Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=   # Client secret value
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
ALLOWED_EMAIL_DOMAIN=allstartalent.us
ADMIN_EMAILS=sam@allstartalent.us # comma-separated; these people can edit clients and run imports

# ---- Database (Vercel -> Storage -> Neon Postgres sets this for you) ----
DATABASE_URL=

# ---- Weekly job ----
CRON_SECRET=                      # any long random string; Vercel sends it to the cron route

# ---- Outlook reports (Microsoft Graph, same Entra app, application permission Mail.Read) ----
GRAPH_TENANT_ID=
GRAPH_MAILBOX=sam@allstartalent.us
GRAPH_FOLDER=CPC Reports

# ---- Meta Marketing API (optional; turns on when both are set) ----
META_ACCESS_TOKEN=                # System User token with ads_read
META_AD_ACCOUNT_IDS=              # comma-separated, numbers only, e.g. 22111642xxxxxxx
META_API_VERSION=v23.0

# ---- Google Ads API (optional; turns on when all are set) ----
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=     # manager account ID, digits only
GOOGLE_ADS_API_VERSION=v21
